{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__elements": {},
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.2.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Pipeline Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "id": 100
    },
    {
      "title": "Traces Sent Rate (Data Provider)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "expr": "rate(data_provider_traces_sent_total[1m])",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "P-Wave Detections Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "targets": [
        { "expr": "rate(pwave_detections_total[1m])", "legendFormat": "Consumer Mode", "refId": "A" },
        { "expr": "rate(pwave_lb_detections_total[1m])", "legendFormat": "Load-Balanced Mode", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Loc-Mag Estimations Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "targets": [
        { "expr": "rate(locmag_estimations_total[1m])", "legendFormat": "estimations/s", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "WebSocket Broadcast Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 4,
      "targets": [
        { "expr": "rate(ws_messages_broadcast_total[1m])", "legendFormat": "Express {{topic}}", "refId": "A" },
        { "expr": "rate(fastapi_ws_messages_broadcast_total[1m])", "legendFormat": "FastAPI {{topic}}", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Active WebSocket Clients",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 9 },
      "id": 5,
      "targets": [
        { "expr": "ws_active_clients", "legendFormat": "Express.js", "refId": "A" },
        { "expr": "fastapi_ws_active_clients", "legendFormat": "FastAPI", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 50,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 40 }
            ]
          }
        }
      }
    },
    {
      "title": "Error Rates (All Modules)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 9 },
      "id": 6,
      "targets": [
        { "expr": "rate(data_provider_publish_errors_total[5m])", "legendFormat": "DataProvider", "refId": "A" },
        { "expr": "rate(pwave_inference_errors_total[5m])", "legendFormat": "P-Wave", "refId": "B" },
        { "expr": "rate(lb_forward_errors_total[5m])", "legendFormat": "LoadBalancer", "refId": "C" },
        { "expr": "rate(locmag_errors_total[5m])", "legendFormat": "LocMag", "refId": "D" },
        { "expr": "rate(archiver_save_errors_total[5m])", "legendFormat": "Archiver {{storage}}", "refId": "E" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Latency",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "id": 101
    },
    {
      "title": "P-Wave Inference Latency (P50 / P95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 7,
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(pwave_inference_latency_seconds_bucket[5m]))", "legendFormat": "Consumer P95", "refId": "A" },
        { "expr": "histogram_quantile(0.50, rate(pwave_inference_latency_seconds_bucket[5m]))", "legendFormat": "Consumer P50", "refId": "B" },
        { "expr": "histogram_quantile(0.95, rate(pwave_lb_inference_latency_seconds_bucket[5m]))", "legendFormat": "LB Mode P95", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Loc-Mag Inference Latency (P50 / P95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 9,
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(locmag_inference_latency_seconds_bucket[5m]))", "legendFormat": "P95", "refId": "A" },
        { "expr": "histogram_quantile(0.50, rate(locmag_inference_latency_seconds_bucket[5m]))", "legendFormat": "P50", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "End-to-End Data Delay (P95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 10,
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(pwave_end_to_end_latency_seconds_bucket[5m]))", "legendFormat": "P-Wave E2E P95", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(locmag_end_to_end_latency_seconds_bucket[5m]))", "legendFormat": "Loc-Mag E2E P95", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "WebSocket Broadcast Latency (P50 / P95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 11,
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(ws_broadcast_latency_seconds_bucket[5m]))", "legendFormat": "Express P95", "refId": "A" },
        { "expr": "histogram_quantile(0.50, rate(ws_broadcast_latency_seconds_bucket[5m]))", "legendFormat": "Express P50", "refId": "B" },
        { "expr": "histogram_quantile(0.95, rate(fastapi_ws_broadcast_latency_seconds_bucket[5m]))", "legendFormat": "FastAPI P95", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Resource Usage (Host & Containers)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false,
      "id": 102
    },
    {
      "title": "CPU Usage (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "id": 12,
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "Host CPU %",
          "refId": "A"
        },
        {
          "expr": "sum by(container_name) (docker_container_cpu_usage_percent)",
          "legendFormat": "{{container_name}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Memory Usage (MB)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "id": 13,
      "targets": [
        {
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / 1024 / 1024",
          "legendFormat": "Host Used Mem (MB)",
          "refId": "A"
        },
        {
          "expr": "sum by(container_name) (docker_container_mem_usage) / 1048576",
          "legendFormat": "{{container_name}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Prometheus Scrape Duration (per target)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 43 },
      "id": 14,
      "targets": [
        {
          "expr": "scrape_duration_seconds",
          "legendFormat": "{{job}} ({{instance}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["gempa", "observability", "prometheus"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "GEMPA Observability Dashboard",
  "uid": "eews-observability-v2",
  "version": 1,
  "refresh": "10s"
}
