# ==============================================================================
# InfluxDB Initialization Settings (Template)
# Copy this file to `.env` inside the influxDB folder before starting.
# ==============================================================================
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=YOUR_SECURE_INFLUXDB_PASSWORD_HERE
DOCKER_INFLUXDB_INIT_BUCKET=gempa
DOCKER_INFLUXDB_INIT_ORG=owner
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=YOUR_SUPER_SECRET_INFLUXDB_TOKEN_HERE
